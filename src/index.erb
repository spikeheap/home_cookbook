---
layout: default
title: Home
---
<%
  all_recipes = collections.recipes.resources
  by_name = ->(list) { list.sort_by { |r| r.data.name.to_s.downcase } }
  # Sweet has its own page; Tonight is savoury-only.
  savoury = all_recipes.reject { |r| sweet?(r) }

  favourites = by_name.(all_recipes.select { |r| r.data.status == "favourite" })
  weeknight  = by_name.(savoury.select { |r| r.data.effort == "weeknight" })
  latest     = all_recipes.sort_by { |r| r.data.date.to_s }.reverse.first(5)
%>
<form class="home-search" role="search" onsubmit="return false;">
  <label class="home-search__label" for="search-input">Find a recipe</label>
  <input type="search"
         placeholder="Name, ingredient or cuisine"
         aria-autocomplete="list"
         aria-controls="search-results"
         autocomplete="off"
         spellcheck="false"
         id="search-input">
  <div class="search-results" id="search-results" role="listbox" aria-label="Search results" hidden></div>
</form>

<p class="home-plan" data-plan-summary hidden>
  <a href="<%= relative_url '/plan/' %>">This week: <span data-plan-count></span> planned. Shopping list</a>
</p>

<div class="home-lists">
  <section class="home-list home-list--favourites">
    <h2 class="home-list__title">Favourites</h2>
    <ul class="home-list__items">
      <% favourites.each do |r| %>
        <%= render "recipe_list_item", recipe: r, meta: r.data.cuisine %>
      <% end %>
    </ul>
  </section>

  <section class="home-list">
    <h2 class="home-list__title">Tonight</h2>
    <ul class="home-list__items">
      <% weeknight.first(12).each do |r| %>
        <%= render "recipe_list_item", recipe: r, meta: r.data.cuisine %>
      <% end %>
    </ul>
    <a class="home-list__more" href="<%= relative_url '/all/#weeknight' %>">All <%= weeknight.size %> weeknight recipes</a>
  </section>

  <section class="home-list">
    <h2 class="home-list__title">Recently added</h2>
    <ul class="home-list__items">
      <% latest.each do |r| %>
        <%= render "recipe_list_item", recipe: r, meta: r.data.cuisine %>
      <% end %>
    </ul>
  </section>
</div>

<nav class="home-browse" aria-label="Browse">
  <a href="<%= relative_url '/all/#weekend' %>">Weekend</a>
  <a href="<%= relative_url '/all/#project' %>">Projects</a>
  <a href="<%= relative_url '/by-tag/#pizza' %>">Pizza</a>
  <a href="<%= relative_url '/by-tag/#pasta' %>">Pasta</a>
  <a href="<%= relative_url '/sweet/' %>">Sweet</a>
  <a href="<%= relative_url '/by-cuisine/' %>">By cuisine</a>
  <a href="<%= relative_url '/by-tag/' %>">By tag</a>
</nav>
